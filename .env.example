# API Keys - Required for the models you want to use
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Optional API Keys
GOOGLE_API_KEY=your-google-api-key-here
GROQ_API_KEY=your-groq-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional: Custom API Base URLs
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com

# Optional: LangSmith for tracing/observability
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=your-project-name
# LANGSMITH_TRACING=true

# Optional: Supabase for authentication
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-key

# Optional: Configuration flags
# GET_API_KEYS_FROM_CONFIG=false
# GET_API_BASE_URL_FROM_CONFIG=false

# Server Configuration
PORT=8000
